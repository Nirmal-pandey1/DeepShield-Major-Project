# Hosted MySQL URL. URL-encode special characters in the username or password.
DATABASE_URL=mysql+pymysql://DB_USER:URL_ENCODED_PASSWORD@DB_HOST:3306/DB_NAME?charset=utf8mb4
# Set this to the CA certificate path if your MySQL provider requires it.
# SSL_CA_PATH=certs/provider-ca.pem

SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
